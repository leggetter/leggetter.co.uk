  "description": "www.leggetter.co.uk website",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "prebuild": "git submodule init && git submodule sync && git submodule update && node scripts/copy-guide-images.mjs",
    "predev": "node scripts/copy-guide-images.mjs",
    "preview": "astro preview",
    "verify": "node scripts/verify-urls.mjs",
    "test:game": "node --test 'src/games/deadball/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "generate-family-tree": "python3 leggetter-family-tree/tree-view-family-chart.py leggetter-family-tree/0001tree.gen --output-astro",
    "voice": "node scripts/check-voice.mjs",
    "voice:sections": "node scripts/voice-by-section.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leggetter/leggetter.co.uk.git"
  },
  "keywords": [
    "website",
    "astro",
    "leggetter",
    "real-time",
    "web",
    "technology"
