---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getListedPosts, PAGE_SIZE } from '../../lib/posts';

const posts = await getListedPosts();
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
const pagePosts = posts.slice(0, PAGE_SIZE);
---

<Base title="Blog" description="All of Phil Leggetter's blog posts, from 2005 onwards.">
  <h1>Blog</h1>
  <ul class="post-list">
    {
      pagePosts.map((post) => (
        <PostCard
          url={post.url}
          title={post.entry.data.title}
          date={post.date}
          excerpt={post.excerpt}
          thumb={post.entry.data.thumb}
          draft={post.draft}
        />
      ))
    }
  </ul>
  <Pagination page={1} totalPages={totalPages} />
</Base>
