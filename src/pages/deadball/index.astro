    touch-action: manipulation;
  }

  #style:hover {
    background: rgba(12, 30, 50, 0.85);
  }

  #style:focus-visible {
    outline: 2px solid #7dd3fc;
    outline-offset: 2px;
  }

  #style-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  #style-hint {
