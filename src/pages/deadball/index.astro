  #modes button,
  #views button,
  #settings-open {
    /* Never wrapped onto two lines: a label that wraps is also a label that
       has been squeezed, and the bar should move before the words do. */
    white-space: nowrap;
    /* Big enough to hit with a thumb; the WCAG target minimum is 24px. */
    min-height: 32px;
    padding: 0 10px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    background: rgba(8, 20, 30, 0.55);
