---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" sidebar={false}>
  <h1>Page not found</h1>
  <p>
    That page doesn't exist (or may have moved when the site's URLs were modernised — old blog
    URLs should redirect automatically).
  </p>
  <p>
    Try the <a href="/">homepage</a>, or <a href="mailto:phil@leggetter.co.uk">let me know</a> if
    you followed a broken link.
  </p>
</Base>
