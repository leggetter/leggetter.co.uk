  .panel {
    /* This page does not load the site stylesheet, so the global border-box
       rule is not under it: without this the 22px of padding and the 1px
       border sat outside the width and the panel came out 386px wide in a
       375px viewport, clipped on both dialogs. The same line fixed the naming
       form when it was measured at 390px. */
    box-sizing: border-box;
    width: min(340px, calc(100vw - 32px));
    /* The dialog has grown a roster. Scroll it rather than let it run off a
       phone, and leave room so it never touches the edges. */
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    padding: 22px;
    border-radius: 14px;
    border: 1px solid rgba(125, 211, 252, 0.28);
