---
// Hidden page: built and reachable, but carrying noindex, absent from the
// sitemap, and linked from nowhere. See src/lib/hidden.mjs, which is what
// astro.config.mjs and scripts/verify-urls.mjs both read.
import Fullscreen from '../../layouts/Fullscreen.astro';
import { DEFAULT_CAMERA, listCameras } from '../../games/deadball/presentation/registry.ts';
import { DEFAULT_SKY_ID, SKIES } from '../../games/deadball/content/skies.js';
import { DISCIPLINES } from '../../games/deadball/core/setpiece.ts';

// Rendered here rather than built in the browser. Astro scopes component CSS
// by stamping an attribute on the elements in the template, so buttons created
// with document.createElement never matched any of it and came out as bare
// browser defaults - which is why the selected one looked like the others.
// Rendering them also means the switcher is there before the game starts.
const views = listCameras();
---

<Fullscreen
  title="Dead Ball"
  description="A penalty shootout. Drag to aim, release in the green, and bend it round the wall."
  backHref="/"
  backLabel="Home"
  noindex
>
  <div id="pitch-wrap">
    <canvas id="pitch"></canvas>
    {/*
      Real buttons rather than something hit-tested on the canvas: they are
      reachable by keyboard, readable by a screen reader, and get focus rings
      and tap targets for nothing. The game only has to be told which one was
      pressed.
    */}
    {/*
      Bottom left, on its own, away from the bar.

      It is not a mode and not a setting: it is a decision you make between one
      shot and the next, so it sits where your thumb already is rather than two
      taps into a dialog. The bar is also full, and this project has learned
      what happens when something else goes in it.
    */}
    <button type="button" id="style" aria-live="polite">
      <span id="style-label">Finesse</span>
      <span id="style-hint"></span>
    </button>

    {/*
      One flex row rather than two absolutely positioned corners.

      This bar has now overflowed three times, once per feature that added a
      button, and every time for the same reason: two clusters placed
      independently, neither able to see the other. Flex items cannot overlap.
      With room, the modes sit centred; without it they slide left rather than
      landing on top of the cameras.
    */}
    <div id="bar">
      <span id="bar-gap" aria-hidden="true"></span>
      <nav id="modes" aria-label="Players">
        <button type="button" data-mode="solo" aria-pressed="true"
          ><span class="wide">1 player</span><span class="narrow" aria-hidden="true">1P</span
        ></button>
        <button type="button" data-mode="versus" aria-pressed="false"
          ><span class="wide">v computer</span><span class="narrow" aria-hidden="true">v CPU</span
        ></button>
        <button type="button" data-mode="duel" aria-pressed="false"
          ><span class="wide">2 players</span><span class="narrow" aria-hidden="true">2P</span
        ></button>
        {/*
          A shirt, not a cog and not a person. Choosing a player is about which
          kit runs up, and the swatches in the dialog are the same idea - so the
          button says what is behind it without a word on it.
        */}
        <button type="button" id="squad-open" title="Players">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="icon">
            <path
              d="M9 3.2 15 3.2 20.8 6.6 18.4 11 16.6 9.9 16.6 20.8 7.4 20.8 7.4 9.9 5.6 11 3.2 6.6Z"
              fill="none"
              stroke="currentColor"
              stroke-width="2.1"
              stroke-linejoin="round"
            />
            <path
              d="M9 3.2Q12 6.9 15 3.2"
              fill="none"
              stroke="currentColor"
              stroke-width="2.1"
              stroke-linecap="round"
            />
          </svg>
          <span class="visually-hidden">Players</span>
        </button>
      </nav>
      {/*
        The far corner, behind a rule, away from everything that changes the
        game. A cog next to "2 players" reads as another thing to play with.
      */}
      <div id="right">
        <nav id="views" aria-label="Camera angle">
          <span id="views-label">Camera</span>
          {
            views.map(({ id, label }) => (
              <button type="button" data-view={id} aria-pressed={String(id === DEFAULT_CAMERA)}>
                {label}
              </button>
            ))
          }
        </nav>
        <button type="button" id="settings-open" title="Settings">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="icon">
            <circle cx="12" cy="12" r="5.2" fill="none" stroke="currentColor" stroke-width="3.2" />
            <path
              d="M18.2 12h2.4M5.8 12H3.4M12 18.2v2.4M12 5.8V3.4M16.38 16.38l1.7 1.7M7.62 7.62L5.92 5.92M7.62 16.38l-1.7 1.7M16.38 7.62l1.7-1.7"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            />
          </svg>
          <span class="visually-hidden">Settings</span>
        </button>
      </div>
    </div>
    {/*
      Real text inputs rather than something typed onto the canvas: a phone
      keyboard, autocapitalisation, paste and a screen reader all come free,
      and none of them would have without a form. Hidden until a duel starts.
    */}
    {/*
      ph-no-capture: this site loads PostHog on every page, this one included.
      Autocapture does not send input values and session replay masks them by
      default, so names were almost certainly never leaving the device - and
      "almost certainly, depending on a setting in a dashboard" is not a good
      enough answer for a box a child types their name into. The class is
      PostHog's own opt-out and it holds for both, so it is the page that keeps
      names off the wire rather than a remote config nobody here can see.

      This used to be justified by a line of small print under the form saying
      names never leave the device. The small print has gone; the reason for
      the class has not, and it is the code rather than the sentence that was
      ever doing the work.
    */}
    {/*
      Asked before the dialog that starts a game, not inside it.

      It was a line of amber text in the form first. That is a warning, and a
      warning can be read past - the button beside it still said "Start the
      shootout" and still did. Ending a game somebody is in the middle of is a
      decision, so it gets asked as one, and the two dialogs are sequential
      rather than stacked: this one closes before the other opens.
    */}
    {/*
      The waiting screen: where a game is sent, and the screen everybody sees
      because every two-device game passes through it.

      Its whole job is to be left, so there is no spinner and no tip on it.
      Team, kick, a code to point a camera at, a link to send, and a way out.
    */}
    <dialog id="lobby" aria-labelledby="lobby-heading">
      <div id="lobby-body" class="panel">
        <h2 id="lobby-heading">Waiting for somebody</h2>
        <p id="lobby-line"><b id="lobby-team">Your team</b> vs <span id="lobby-other">waiting…</span></p>
        <p id="lobby-kick">Penalties shootout</p>

        <div id="lobby-qr" aria-hidden="true"></div>

        <p id="lobby-link"></p>
        <div id="lobby-actions">
          <button type="button" id="lobby-copy">Copy link</button>
          <button type="button" id="lobby-share" hidden>Share</button>
          <button type="button" id="lobby-cancel">Cancel</button>
        </div>
      </div>
    </dialog>

    {/*
      What you are being invited to, before you accept it.

      The guest sees the host's team and the kick first. Accepting something
      you have not been shown is not accepting.
    */}
    <dialog id="accept" class="ph-no-capture" aria-labelledby="accept-heading">
      <form id="accept-form">
        <h2 id="accept-heading">You have been invited</h2>
        <p id="accept-blurb"></p>
        <label for="accept-name">Your team</label>
        <input id="accept-name" name="acceptName" type="text" maxlength="24"
          autocomplete="off" spellcheck="false" placeholder="Your team" />
        <div id="accept-actions">
          <button type="submit">Join the game</button>
          <button type="button" id="accept-no">No thanks</button>
        </div>
      </form>
    </dialog>

    <dialog id="confirm" aria-labelledby="confirm-heading">
      <div id="confirm-body" class="panel">
        <h2 id="confirm-heading">End this shootout?</h2>
        <p id="confirm-blurb">You are in the middle of one.</p>
        <div id="confirm-actions">
          <button type="button" id="confirm-yes">End it and start again</button>
          <button type="button" id="confirm-no">Keep playing</button>
        </div>
      </div>
    </dialog>

    <dialog id="names" class="ph-no-capture" aria-labelledby="names-heading">
      <form id="names-form">
        <h2 id="names-heading">Who is playing?</h2>
        <p id="names-blurb">Whoever goes first shoots first. You can change these any
          time by pressing <b>2 players</b> again.</p>
        <label for="name-0" id="label-0">Shoots first</label>
        <input id="name-0" name="name0" type="text" maxlength="24" autocomplete="off"
          spellcheck="false" placeholder="Player 1" />
        <label for="name-1" id="label-1">Keeps first</label>
        <input id="name-1" name="name1" type="text" maxlength="24" autocomplete="off"
          spellcheck="false" placeholder="Player 2" />
        {/*
          The computer's side, named by you. In the template and hidden rather
          than created when `versus` is picked: Astro scopes this component's
          CSS by stamping an attribute on the elements it renders, so anything
          document.createElement builds matches none of it and comes out as a
          bare browser default. That has caught this page three times.

          No placeholder here. It is whatever the opponent is called, which
          lives in content/takers.js, and writing it into the markup would be a
          second copy to keep in step. The script fills it in.
        */}
        <label for="name-opponent" id="label-opponent" hidden>Their team</label>
        <input id="name-opponent" name="nameOpponent" type="text" maxlength="24"
          autocomplete="off" spellcheck="false" hidden />

        {/*
          Which kick, asked where the game starts rather than in Settings.
          It decides what you are about to play, and a thing you choose once
          per shootout belongs with the other things you choose once per
          shootout - not two taps away beside the sound.
        */}
        <h3 id="where-heading" hidden>Where</h3>
        <div class="choices" id="where-choices" hidden>
          <button type="button" data-where="here" aria-pressed="true">This device</button>
          <button type="button" data-where="apart" aria-pressed="false">Two devices</button>
        </div>

        <h3 id="kick-heading">Kick</h3>
        <div class="choices" id="kick-choices">
          {
            DISCIPLINES.map(({ id, label }) => (
              <button type="button" data-kick={id} aria-pressed={String(id === 'penalties')}>
                {label}
              </button>
            ))
          }
        </div>
        <p id="kick-note">Free kick positions and the wall are different every kick.</p>

        <div id="names-actions">
          <button type="submit">Start the shootout</button>
          <button type="button" id="names-cancel">Cancel</button>
        </div>
      </form>
    </dialog>
    {/*
      Sound and time of day used to be two more buttons in the row above, which
      on a phone ran underneath the camera list and could not be tapped at all.
      They are settings rather than things you reach for mid-shot, so they
      belong behind one button - and the row goes back to being about what you
      are playing.
    */}
    {/*
      Two dialogs, not one. Who takes the penalty is part of the game; sound
      and the time of day are preferences about the machine you are playing on.
      They were in one panel for exactly one phase and it was already the
      longest thing on the screen.
    */}
    <dialog id="squad" aria-labelledby="squad-heading">
      <div id="squad-body" class="panel">
        <h2 id="squad-heading">Players</h2>

        {/*
          Two headed halves rather than one long run: who takes them, then what
          everybody wears. The dialog was already the longest thing on the
          screen and six colour inputs is what made the seam worth marking.
        */}
        <h3>Squad</h3>
        <div id="player-list" class="stack"></div>
        <p id="player-stats"></p>
        <div id="player-actions">
          <button type="button" id="player-invent">Invent one</button>
          <button type="button" id="player-delete" hidden>Delete</button>
        </div>

        {/*
          Inline rather than a second dialog. A dialog on top of a dialog is a
          back button nobody can predict, and this form is four numbers.
        */}
        <form id="player-form" hidden>
          <label for="player-name">Name</label>
          <input id="player-name" type="text" maxlength="18" autocomplete="off"
            spellcheck="false" placeholder="New Player" />

          {/*
            aria-live so the budget is announced when a slider moves it. A
            slider that silently refuses to go further is the one part of this
            form that needs saying out loud.
          */}
          <p id="skill-budget" aria-live="polite">
            <span id="skill-left">0</span> points left
          </p>

          <div class="skills">
            <label for="skill-power">Power</label>
            <input id="skill-power" type="range" min="0" max="100" value="75" />
            <output for="skill-power">75</output>

            <label for="skill-accuracy">Accuracy</label>
            <input id="skill-accuracy" type="range" min="0" max="100" value="75" />
            <output for="skill-accuracy">75</output>

            <label for="skill-curve">Curve</label>
            <input id="skill-curve" type="range" min="0" max="100" value="75" />
            <output for="skill-curve">75</output>

            <label for="skill-composure">Composure</label>
            <input id="skill-composure" type="range" min="0" max="100" value="75" />
            <output for="skill-composure">75</output>

            <label for="skill-dip">Dip</label>
            <input id="skill-dip" type="range" min="0" max="100" value="75" />
            <output for="skill-dip">75</output>
          </div>

          <h3>Foot</h3>
          <div class="choices" id="foot-choices">
            <button type="button" data-foot="left" aria-pressed="false">Left</button>
            <button type="button" data-foot="right" aria-pressed="true">Right</button>
          </div>

          <div class="kit">
            <label for="kit-colour">Shirt</label>
            <input id="kit-colour" type="color" value="#2f6fd0" />
            <label for="trim-colour">Trim</label>
            <input id="trim-colour" type="color" value="#f4f6f8" />
          </div>

          <div id="player-form-actions">
            <button type="submit">Add</button>
            <button type="button" id="player-cancel">Cancel</button>
          </div>
        </form>

        {/*
          Kits, in here rather than in settings, and for the reason the two
          dialogs were split in the first place: what the teams wear is part of
          the game, and sound and the time of day are preferences about the
          machine. Still one dialog - it scrolls, and a third would be a third
          thing to find - but the two halves are headed now rather than running
          on, because six colour inputs after a squad list needs a line drawn
          between them.

          In the template, not document.createElement. Astro scopes this
          component's CSS by stamping an attribute on the elements it renders,
          so anything built in the browser matches none of it and comes out as
          a bare default. That has caught this page three times.

          No values in the markup. The defaults are derived - your side from
          whoever is taking the penalties, theirs from the away colour - and
          writing them here would be a second copy to keep in step. The script
          fills them in, and fills them in again when the taker changes.
        */}
        <h3>Kits</h3>
        <p id="kit-note">Four strips, all six pairs on screen at once. Two that
          land too close together get nudged apart, and a keeper's shorts follow
          their own shirt.</p>

        <div class="strips">
          <span></span>
          <span class="strip-head">Shirt</span>
          <span class="strip-head">Shorts</span>
          <span class="strip-head">Keeper</span>

          <span class="strip-side">Yours</span>
          <input id="strip-own" type="color" aria-label="Your shirt" />
          <input id="strip-ownTrim" type="color" aria-label="Your shorts" />
          <input id="strip-ownKeeper" type="color" aria-label="Your keeper's shirt" />

          <span class="strip-side">Theirs</span>
          <input id="strip-other" type="color" aria-label="Their shirt" />
          <input id="strip-otherTrim" type="color" aria-label="Their shorts" />
          <input id="strip-otherKeeper" type="color" aria-label="Their keeper's shirt" />
        </div>

        <div id="kit-actions">
          <button type="button" id="kit-reset">Back to the default kits</button>
        </div>

        <div id="squad-actions">
          <button type="button" id="squad-close">Done</button>
        </div>
      </div>
    </dialog>

    <dialog id="settings" aria-labelledby="settings-heading">
      <div id="settings-body" class="panel">
        <h2 id="settings-heading">Settings</h2>

        <h3>Sound</h3>
        <div class="choices" id="sound-choices">
          <button type="button" data-sound="on" aria-pressed="true">On</button>
          <button type="button" data-sound="off" aria-pressed="false">Off</button>
        </div>

        <h3>Time of day</h3>
        <div class="choices" id="sky-choices">
          {
            SKIES.map(({ id, label }) => (
              <button type="button" data-sky={id} aria-pressed={String(id === DEFAULT_SKY_ID)}>
                {label}
              </button>
            ))
          }
        </div>

        {/*
          The log only ever came out by pressing L, which nobody who had not
          read the docs was going to find. The key still works for anyone who
          has it in their fingers; this is the half you can discover. It sits in
          settings rather than in the bar because it is a diagnostic, not
          something you reach for between penalties.
        */}
        <h3>Shot log</h3>
        <div id="log-actions">
          <button type="button" id="log-download">Download shot log</button>
          {/*
            Two presses, not one. Everything that got tuned in this game was
            tuned off these files, and a wipe takes back every sitting at once -
            but confirm() freezes the page for anything driving the browser, so
            the button arms itself instead and disarms again on its own.
          */}
          <button type="button" id="log-clear" data-armed="false">Clear the log</button>
        </div>
        <div id="settings-actions">
          <button type="button" id="settings-close">Done</button>
        </div>
      </div>
    </dialog>
  </div>
</Fullscreen>

<script>
  import { start } from '../../games/deadball/main';
  import { DEFAULT_NAMES, DEFAULT_TEAM } from '../../games/deadball/core/names';
  import { SKIES } from '../../games/deadball/content/skies.js';
  import { SKILL_BUDGET } from '../../games/deadball/core/squad';
  import { DISCIPLINES } from '../../games/deadball/core/setpiece';
  import { createLocalTransport } from '../../games/deadball/net/local';
  import { createRemoteTransport } from '../../games/deadball/net/remote';
  import { forgetRoom, linkTo, roomFrom } from '../../games/deadball/net/link';
  import type { TeamOnTheWire, Transport } from '../../games/deadball/net/Transport';
  import { renderSVG } from 'uqr';
  // The derivation, so the swatches show what the pitch will actually draw
  // rather than what was stored. Five of the six are defaults most of the
  // time, and a default that has been nudged off a clash is still the answer.
  import { teamKits } from '../../games/deadball/presentation/classic/kits';

  const canvas = document.getElementById('pitch');

  if (canvas instanceof HTMLCanvasElement) {
    start(canvas)
      .then((game) => {
        const buttons = [...document.querySelectorAll<HTMLButtonElement>('#views button')];

        const paint = () => {
          const current = game.currentViewId();
          for (const button of buttons) {
            button.setAttribute('aria-pressed', String(button.dataset.view === current));
          }
        };

        for (const button of buttons) {
          button.addEventListener('click', () => {
            const id = button.dataset.view;
            if (id) game.useView(id);
            paint();
            // Take focus off the button, or the next space bar press
            // re-triggers it rather than doing nothing.
            button.blur();
          });
        }

        // The markup guesses the default; the game knows what actually loaded,
        // which may have come from ?view= or from what was stored last time.
        paint();

        const modes = [...document.querySelectorAll<HTMLButtonElement>('#modes button')];
        const paintModes = () => {
          const current = game.currentMode();
          // A remote game is a duel whose other half is somewhere else, so the
          // 2 players button is the one that is lit. Without this the mode was
          // `remote`, no button matched it, and the bar showed a game in
          // progress as no game at all.
          const lit = current === 'remote' ? 'duel' : current;
          for (const button of modes) {
            button.setAttribute('aria-pressed', String(button.dataset.mode === lit));
          }
          const apart = game.connectedAs() !== null;
          for (const button of modes) {
            const wide = button.querySelector<HTMLElement>('.wide');
            const narrow = button.querySelector<HTMLElement>('.narrow');
            if (button.dataset.mode !== 'duel' || !wide || !narrow) continue;
            wide.textContent = apart ? '2 devices' : '2 players';
            narrow.textContent = apart ? '2D' : '2P';
          }
        };

        // A real <dialog>, opened with showModal: focus is trapped inside it,
        // Escape closes it, and everything behind goes inert. A div with
        // hidden looked identical and let Tab walk straight out to the camera
        // buttons underneath.
        const panel = document.getElementById('names') as HTMLDialogElement | null;
        const form = document.getElementById('names-form');
        const fields = [
          document.getElementById('name-0'),
          document.getElementById('name-1'),
        ] as (HTMLInputElement | null)[];
        const opponentField = document.getElementById('name-opponent') as HTMLInputElement | null;
        const opponentLabel = document.getElementById('label-opponent');
        const cancel = document.getElementById('names-cancel');
        const confirmPanel = document.getElementById('confirm') as HTMLDialogElement | null;
        const confirmBlurb = document.getElementById('confirm-blurb');
        const heading = document.getElementById('names-heading');
        const blurb = document.getElementById('names-blurb');
        const labels = [document.getElementById('label-0'), document.getElementById('label-1')];

        /**
         * The same dialog, asking a different question.
         *
         * A duel wants two people's names, because two people are in the room.
         * Against the computer there are two teams to name - yours and theirs -
         * so the duel's second field goes away and the opponent's takes its
         * place, rather than either being filled in with something nobody typed.
         */
        const dressFor = (mode: 'solo' | 'duel' | 'versus', opponent: string) => {
          // Sending an invite is its own shape, and it had none: it borrowed
          // the hotseat duel's, which asks for two people by the role they are
          // about to play. So the person sending the link was asked to name
          // "Shoots first" and "Keeps first" - two strangers, neither of them
          // obviously themselves - and the answer to the second was thrown
          // away, because whoever opens the link says who they are.
          const invite = mode === 'duel' && pendingWhere === 'apart';
          const duel = mode === 'duel' && !invite;
          const solo = mode === 'solo';
          if (heading) {
            heading.textContent = solo
              ? 'On your own'
              : invite
                ? 'Send an invite'
                : duel
                  ? 'Who is playing?'
                  : 'Name the teams';
          }
          if (blurb) {
            blurb.textContent = solo
              ? 'Five of them, against a keeper. Nobody to hand the phone to.'
              : invite
                ? // Said out loud, because the form no longer asks for it and
                  // somebody will wonder where the other name went.
                  'Whoever opens your link says who they are. A coin decides who shoots first.'
                : duel
                  ? 'Whoever goes first shoots first. You can change these any time by pressing 2 players again.'
                  : `Five each against ${opponent}, and you go in goal for theirs.`;
          }
          // Solo has one player and no opponent worth naming, so the whole
          // naming half of this form goes away and the kick choice is the
          // reason the dialog still opens.
          for (const label of labels) if (label) label.hidden = solo;
          for (const field of fields) if (field) field.hidden = solo;
          if (solo) {
            if (opponentLabel) opponentLabel.hidden = true;
            if (opponentField) opponentField.hidden = true;
            return;
          }
          if (labels[0]) {
            labels[0].textContent = invite ? 'Who are you?' : duel ? 'Shoots first' : 'Your team';
          }
          if (fields[0]) fields[0].placeholder = duel ? 'Player 1' : 'Your team';
          // Hiding the label as well as the input, or the form keeps a heading
          // for a field that is not there.
          if (labels[1]) labels[1].hidden = !duel;
          if (fields[1]) fields[1].hidden = !duel;
          if (opponentLabel) opponentLabel.hidden = duel || invite;
          if (opponentField) {
            // Hidden for an invite too. The label was, and the input was not,
            // so the form showed a nameless box with the computer opponent's
            // name sitting in it underneath "Who are you?".
            opponentField.hidden = duel || invite;
            // Their real name, so leaving the field alone visibly keeps it.
            opponentField.placeholder = game.defaultOpponentName();
          }
        };

        const closeNames = () => {
          if (panel?.open) panel.close();
        };

        // Fires however it closed, Escape included, so the buttons repaint once
        // and in one place.
        panel?.addEventListener('close', paintModes);

        let pendingMode: 'solo' | 'duel' | 'versus' = 'solo';

        const kickChoices = [
          ...document.querySelectorAll<HTMLButtonElement>('#kick-choices button'),
        ];
        let pendingKick = game.currentDiscipline();
        let pendingWhere: 'here' | 'apart' = 'here';

        const whereHeading = document.getElementById('where-heading');
        const whereBox = document.getElementById('where-choices');
        const whereChoices = [
          ...document.querySelectorAll<HTMLButtonElement>('#where-choices button'),
        ];
        const paintWhere = () => {
          for (const button of whereChoices) {
            button.setAttribute('aria-pressed', String(button.dataset.where === pendingWhere));
          }
        };
        for (const button of whereChoices) {
          button.addEventListener('click', () => {
            pendingWhere = button.dataset.where === 'apart' ? 'apart' : 'here';
            paintWhere();
            // Re-dressed, because this toggle sits *inside* the dialog: the
            // form was dressed once on opening and then kept asking for two
            // players after you had said the other one was on another device.
            dressFor(pendingMode, game.opponentName());
          });
        }

        const paintKick = () => {
          for (const button of kickChoices) {
            button.setAttribute('aria-pressed', String(button.dataset.kick === pendingKick));
          }
        };
        for (const button of kickChoices) {
          button.addEventListener('click', () => {
            // Held until Start, so backing out of this dialog leaves the game
            // you were already playing exactly as it was - including what it
            // was being played with.
            if (button.dataset.kick) pendingKick = button.dataset.kick;
            paintKick();
          });
        }

        const openNames = (mode: 'solo' | 'duel' | 'versus' = 'solo') => {
          pendingMode = mode;
          pendingKick = game.currentDiscipline();
          paintKick();
          // Only a duel can be played apart. Solo has nobody to send it to and
          // the computer is already here.
          pendingWhere = 'here';
          paintWhere();
          if (whereHeading) whereHeading.hidden = mode !== 'duel';
          if (whereBox) whereBox.hidden = mode !== 'duel';
          if (!panel || !fields[0] || !fields[1]) {
            // No form in the page for some reason: start anyway with whatever
            // names are already stored, rather than stranding the button. A
            // missing input should cost you the rename, not the game.
            game.restart(mode);
            paintModes();
            return;
          }
          // Prefilled with the current names, unless they are the untouched
          // defaults - "Player 1" is what the placeholder already says, and
          // making it real text means it has to be cleared before typing.
          dressFor(mode, game.opponentName());
          const current = game.currentNames();
          const team = game.currentTeam();
          fields[0].value =
            mode === 'versus'
              ? team === DEFAULT_TEAM
                ? ''
                : team
              : current[0] === DEFAULT_NAMES[0]
                ? ''
                : current[0];
          fields[1].value = current[1] === DEFAULT_NAMES[1] ? '' : current[1];
          // Empty unless it has been renamed, for the same reason as the other
          // two: the placeholder already says what it is called, and making
          // that real text means clearing it before typing.
          if (opponentField) {
            const opponent = game.opponentName();
            opponentField.value = opponent === game.defaultOpponentName() ? '' : opponent;
          }
          if (!panel.open) panel.showModal();
          if (mode !== 'solo') {
            fields[0].focus();
            fields[0].select();
          }
        };

        form?.addEventListener('submit', (event) => {
          event.preventDefault();
          // Sent as typed. The game cleans and caps them, so the rules live in
          // one place rather than half here and half there.
          //
          // Both modes send the two sides in scoreboard order. Which field
          // holds side 1 is the only difference: a person in a duel, the
          // opponent's team against the computer.
          const second =
            pendingMode === 'versus' ? (opponentField?.value ?? '') : (fields[1]?.value ?? '');
          // The kick first, so the shootout that starts a line later is the one
          // that was asked for rather than the one before it.
          game.useDiscipline(pendingKick);
          /*
            Leave the room before starting anything, including another room.

            There was exactly one `disconnect()` in this page and it was on the
            lobby's cancel button, so picking a mode while still connected left
            the transport running. The room went on polling and pushing the
            finished match back, `adopt` went on applying it, and the full-time
            screen reappeared on top of whatever had just been started -
            reported as being stuck on the end screen of a two-device game
            while trying to play on your own.
          */
          if (game.connectedAs() !== null) game.disconnect();
          if (pendingMode === 'duel' && pendingWhere === 'apart') {
            const name = fields[0]?.value ?? '';
            closeNames();
            void wire
              .host({ discipline: pendingKick as never, shots: 5 }, myTeam(name))
              .then(({ id, transport }) => {
                follow(transport);
                const label =
                  DISCIPLINES.find((d) => d.id === pendingKick)?.label ?? 'Penalties';
                showLobby(id, name, label);
              });
            return;
          }
          if (pendingMode === 'solo') game.restart('solo');
          else game.restart(pendingMode, [fields[0]?.value ?? '', second]);
          closeNames();
        });

        cancel?.addEventListener('click', closeNames);

        /**
         * Ask before ending a shootout somebody is in the middle of.
         *
         * Sequential rather than stacked - this closes before the other opens -
         * because a dialog on top of a dialog is a back button nobody can
         * predict, which is written down a few sections up in the spec.
         */
        const startGame = (mode: 'solo' | 'duel' | 'versus') => {
          if (!game.inProgress() || !confirmPanel) {
            openNames(mode);
            return;
          }
          pendingMode = mode;
          if (confirmBlurb) {
            // Zero is reachable: a shootout counts as started the moment the
            // ball is struck, and the first kick has no outcome until it lands.
            const kicks = game.kicksTaken();
            confirmBlurb.textContent =
              kicks === 0
                ? 'This one is still in the air. Starting a new shootout ends it.'
                : kicks === 1
                  ? 'One kick has been taken. Starting a new shootout loses it.'
                  : `${kicks} kicks have been taken. Starting a new shootout loses them.`;
          }
          if (!confirmPanel.open) confirmPanel.showModal();
          // Focus the way out rather than the way through, so a stray Enter
          // keeps the game rather than ending it.
          document.getElementById('confirm-no')?.focus();
        };

        document.getElementById('confirm-yes')?.addEventListener('click', () => {
          confirmPanel?.close();
          openNames(pendingMode);
        });
        document.getElementById('confirm-no')?.addEventListener('click', () => {
          confirmPanel?.close();
        });
        // However it closed, Escape included: the buttons go back to showing
        // the mode that is actually being played.
        confirmPanel?.addEventListener('close', paintModes);

        for (const button of modes) {
          button.addEventListener('click', () => {
            const mode = button.dataset.mode;
            // Restarts the shootout, which is the honest thing to do: half a
            // solo round cannot be continued as a duel.
            // Every mode asks now, solo included. It used to start on the
            // press, which was fine while there was nothing to choose and
            // nothing to lose - and is not, now that the kick is chosen here
            // and a press can end a shootout somebody is halfway through.
            if (mode === 'solo' || mode === 'versus' || mode === 'duel') startGame(mode);
            paintModes();
            button.blur();
          });
        }

        paintModes();

        const settings = document.getElementById('settings') as HTMLDialogElement | null;
        const squad = document.getElementById('squad') as HTMLDialogElement | null;

        const playerList = document.getElementById('player-list');
        const playerStats = document.getElementById('player-stats');
        const playerForm = document.getElementById('player-form') as HTMLFormElement | null;
        const inventButton = document.getElementById('player-invent');
        const deleteButton = document.getElementById('player-delete') as HTMLButtonElement | null;
        const skills = ['power', 'accuracy', 'curve', 'composure', 'dip'] as const;
        let foot: 'left' | 'right' = 'right';

        const field = (id: string) => document.getElementById(id) as HTMLInputElement | null;

        const paintPlayers = () => {
          if (!playerList) return;
          const current = game.currentPlayerId();
          playerList.replaceChildren(
            ...game.squad().map((entry) => {
              const button = document.createElement('button');
              button.type = 'button';
              button.className = 'player';
              button.setAttribute('aria-pressed', String(entry.id === current));
              const swatch = document.createElement('span');
              swatch.className = 'swatch';
              swatch.style.background = entry.colors.kit;
              swatch.style.borderColor = entry.colors.trim;
              const label = document.createElement('span');
              // textContent, not innerHTML: this name was typed into a box.
              label.textContent = entry.name;
              button.append(swatch, label);
              button.addEventListener('click', () => {
                game.usePlayer(entry.id);
                paintPlayers();
              });
              return button;
            })
          );

          const chosen = game.squad().find((p) => p.id === current);
          if (playerStats && chosen) {
            playerStats.textContent = `POW ${chosen.power} · ACC ${chosen.accuracy} · CUR ${chosen.curve} · COM ${chosen.composure} · DIP ${chosen.dip} · ${chosen.foot} foot`;
          }
          if (deleteButton) deleteButton.hidden = !chosen?.custom;
          // Your side's default is whoever is taking them, so picking somebody
          // else moves it. Anything overridden stays where it was put.
          paintKits();
        };

        const showForm = (show: boolean) => {
          if (playerForm) playerForm.hidden = !show;
          if (inventButton) inventButton.hidden = show;
          if (show) {
            paintSkills();
            field('player-name')?.focus();
          }
        };

        const skillInputs = skills.map((skill) => field(`skill-${skill}`));
        const skillLeft = document.getElementById('skill-left');
        const budgetLine = document.getElementById('skill-budget');

        const spent = () =>
          skillInputs.reduce((total, input) => total + Number(input?.value ?? 0), 0);

        /**
         * Clamp the slider that just moved, then repaint.
         *
         * Clamped rather than validated on submit: a slider that stops where
         * the points run out says what the rule is while you are breaking it,
         * and there is nothing to read and nothing to undo.
         */
        const paintSkills = (moved?: HTMLInputElement) => {
          if (moved) {
            const others = spent() - Number(moved.value);
            const ceiling = SKILL_BUDGET - others;
            if (Number(moved.value) > ceiling) moved.value = String(Math.max(0, ceiling));
          }
          for (const [i, skill] of skills.entries()) {
            const out = document.querySelector(`output[for="skill-${skill}"]`);
            if (out) out.textContent = skillInputs[i]?.value ?? '';
          }
          const left = SKILL_BUDGET - spent();
          if (skillLeft) skillLeft.textContent = String(left);
          // Spent out is the normal end state, not an error - so it goes quiet
          // rather than red. Only having points going begging is worth a nudge.
          budgetLine?.classList.toggle('spare', left > 0);
        };

        for (const input of skillInputs) {
          input?.addEventListener('input', () => paintSkills(input));
        }

        for (const button of document.querySelectorAll<HTMLButtonElement>('#foot-choices button')) {
          button.addEventListener('click', () => {
            foot = button.dataset.foot === 'left' ? 'left' : 'right';
            for (const other of document.querySelectorAll('#foot-choices button')) {
              other.setAttribute('aria-pressed', String(other === button));
            }
          });
        }

        inventButton?.addEventListener('click', () => showForm(true));
        document.getElementById('player-cancel')?.addEventListener('click', () => showForm(false));

        playerForm?.addEventListener('submit', (event) => {
          event.preventDefault();
          // Sent raw. The game cleans and caps it, so the rules live in one
          // place rather than half here and half in core/squad.ts.
          const id = game.addPlayer({
            name: field('player-name')?.value,
            power: Number(field('skill-power')?.value),
            accuracy: Number(field('skill-accuracy')?.value),
            curve: Number(field('skill-curve')?.value),
            composure: Number(field('skill-composure')?.value),
            dip: Number(field('skill-dip')?.value),
            foot,
            colors: { kit: field('kit-colour')?.value, trim: field('trim-colour')?.value },
          });
          // Straight to being them, because looking at your footballer is the
          // whole reason for the form.
          if (id) game.usePlayer(id);
          if (playerForm) playerForm.reset();
          paintSkills();
          showForm(false);
          paintPlayers();
        });

        deleteButton?.addEventListener('click', () => {
          game.removePlayer(game.currentPlayerId());
          paintPlayers();
        });

        const kitSlots = ['own', 'ownTrim', 'ownKeeper', 'other', 'otherTrim', 'otherKeeper'] as const;
        const kitInputs = kitSlots.map((slot) => field(`strip-${slot}`));

        /**
         * The long form of a hex colour.
         *
         * Not a second validator - everything reaching this has already been
         * through `cleanColour`. `<input type="color">` simply refuses the
         * three-digit form and keeps whatever it had, which shows as the
         * previous colour rather than as an error, and a hand-edited squad is
         * entitled to write `#09f`.
         */
        const longHex = (colour: string) =>
          /^#[0-9a-fA-F]{3}$/.test(colour)
            ? `#${colour[1]}${colour[1]}${colour[2]}${colour[2]}${colour[3]}${colour[3]}`
            : colour;

        /**
         * Put the four strips in the six swatches.
         *
         * Resolved rather than stored: the swatch shows what will be drawn, so
         * a colour that had to be nudged off another one says so by being the
         * nudged colour. `except` is whichever picker is mid-gesture - writing
         * to it while it is being dragged fights the native control, so it is
         * left alone until the gesture commits and `change` repaints the lot.
         */
        const paintKits = (except?: HTMLInputElement | null) => {
          const chosen = game.squad().find((p) => p.id === game.currentPlayerId());
          if (!chosen) return;
          const kits = teamKits(chosen.colors.kit, chosen.colors.trim, game.kitOverrides());
          const showing = {
            own: kits.own.kit,
            ownTrim: kits.own.trim,
            ownKeeper: kits.ownKeeper.kit,
            other: kits.other.kit,
            otherTrim: kits.other.trim,
            otherKeeper: kits.otherKeeper.kit,
          };
          for (const [i, slot] of kitSlots.entries()) {
            const input = kitInputs[i];
            if (!input || input === except) continue;
            input.value = longHex(showing[slot]);
          }
        };

        for (const [i, slot] of kitSlots.entries()) {
          const input = kitInputs[i];
          // Stored on the first move rather than behind a separate "use this"
          // toggle. Touching a picker is the act of choosing, and six of those
          // plus six checkboxes is a paint program, not a dialog.
          //
          // Two events, because they answer different questions. `input` fires
          // all the way through the gesture and is what makes the pitch follow
          // the picker live. `change` fires once at the end, and is where the
          // picker itself is allowed to snap to the colour that will actually
          // be drawn - which is the same one, unless it had to be nudged off
          // something else.
          input?.addEventListener('input', () => {
            game.setKit(slot, input.value);
            paintKits(input);
          });
          input?.addEventListener('change', () => {
            game.setKit(slot, input.value);
            paintKits();
          });
        }

        document.getElementById('kit-reset')?.addEventListener('click', () => {
          // Clears, rather than writing today's defaults back in. A stored
          // colour that happens to equal the default is still a stored colour,
          // and it would stop following the taker the moment they changed.
          game.resetKits();
          paintKits();
        });

        const soundChoices = [
          ...document.querySelectorAll<HTMLButtonElement>('#sound-choices button'),
        ];
        const styleButton = document.getElementById('style');
        const styleLabel = document.getElementById('style-label');
        const styleHint = document.getElementById('style-hint');

        const paintStyle = (): void => {
          const style = game.currentStyle();
          if (styleLabel) styleLabel.textContent = style.label;
          if (styleHint) styleHint.textContent = style.hint;
          styleButton?.setAttribute('aria-label', `Shot: ${style.label}. ${style.hint}`);
        };

        // Off when it is not your kick. The canvas stopped accepting drags on
        // somebody else's turn, and this button sat on top of it still live,
        // reading "Finesse - placed and bent" on the screen of a person who
        // could not strike anything. Worse than useless: it parses as a
        // description of the shot about to be taken, which is the opponent's.
        game.onTurn((yours) => {
          const apart = game.connectedAs() !== null;
          const off = apart && !yours;
          if (styleButton) {
            styleButton.disabled = off;
            styleButton.setAttribute('aria-hidden', off ? 'true' : 'false');
          }
        });

        styleButton?.addEventListener('click', (event) => {
          game.cycleStyle();
          paintStyle();
          // Or it keeps the focus ring and the next Enter cycles it again when
          // somebody meant to take the penalty.
          (event.currentTarget as HTMLButtonElement).blur();
        });
        paintStyle();

        /*
          Two devices. The transport is the same interface a Durable Object
          will be reached through, so none of what follows learns which it is
          talking to - today it is another tab.
        */
        /*
          Which wire, decided by whether there is a server to talk to.

          With `PUBLIC_DEADBALL_ROOMS` set, games go through the Durable Object
          and two *devices* can play. Without it they go through a
          BroadcastChannel and two *tabs* can - which is every local checkout,
          and is how the whole protocol was debugged before any of this
          existed.

          The storage differs with it, and has to. Across two devices a browser
          is a player, so the token lives in localStorage and survives closing
          the tab. Across two tabs of one browser they would share it and the
          room would read the second join as the first player reloading - so
          the local wire gets sessionStorage, which is per tab. See `tokenFor`.
        */
        const roomsAt = import.meta.env.PUBLIC_DEADBALL_ROOMS as string | undefined;
        const wire = roomsAt
          ? createRemoteTransport(roomsAt.replace(/\/$/, ''), window.localStorage)
          : createLocalTransport(window.sessionStorage);
        const lobby = document.getElementById('lobby') as HTMLDialogElement | null;
        const accept = document.getElementById('accept') as HTMLDialogElement | null;
        let live: Transport | null = null;

        /** This side, as it goes on the wire. */
        const myTeam = (name: string): TeamOnTheWire => {
          const chosen = game.squad().find((p) => p.id === game.currentPlayerId());
          return {
            name,
            // A squad rather than a player, because the intention is that every
            // kick is taken by a different one of them.
            squad: chosen ? [chosen] : [],
            kit: { kit: chosen?.colors.kit ?? '#2f6fd0', trim: chosen?.colors.trim ?? '#f4f6f8' },
          };
        };

        const setLobbyText = (id: string, text: string) => {
          const el = document.getElementById(id);
          if (el) el.textContent = text;
        };

        /** Watch a room and keep the waiting screen honest about it. */
        const follow = (transport: Transport) => {
          live = transport;
          transport.onMessage((message) => {
            if (message.kind === 'error') {
              setLobbyText('lobby-other', message.reason);
              return;
            }
            if (message.kind !== 'state') return;
            const them = message.teams[1 - message.you];
            const waiting = !them.name;
            setLobbyText('lobby-other', waiting ? 'waiting…' : them.name);
            setLobbyText('lobby-team', message.teams[message.you].name || 'Your team');
            if (!waiting && lobby?.open) {
              // Both in. Say what the coin said, then get out of the way and
              // hand the match to the room.
              const yours = message.first === message.you;
              setLobbyText(
                'lobby-heading',
                yours ? 'You shoot first' : `${them.name} shoots first`
              );
              const mine = message.teams[message.you].name;
              const theirs = them.name;
              window.setTimeout(() => {
                lobby?.close();
                game.connect(
                  transport,
                  message.you,
                  message.first,
                  // **Match-side order, not seat order.** Everything that draws
                  // indexes names by `taker` and `keeperSide`, which are sides
                  // of the tie - and match side 0 is whichever *seat* the coin
                  // gave the first kick to. Handing these over in seat order
                  // put the wrong name on every turn message whenever the coin
                  // came down on the guest, including telling a player they
                  // were waiting for themselves.
                  message.first === message.you ? [mine, theirs] : [theirs, mine]
                );
                paintModes();
              }, 1800);
            }
          });
        };

        /** Put a room on screen: code, link, and something to point a camera at. */
        const showLobby = (id: string, team: string, kick: string) => {
          const link = linkTo(id, new URL(window.location.href));
          setLobbyText('lobby-team', team || 'Your team');
          setLobbyText('lobby-other', 'waiting…');
          setLobbyText('lobby-heading', 'Waiting for somebody');
          setLobbyText('lobby-kick', `${kick} shootout`);
          setLobbyText('lobby-link', link);
          const qr = document.getElementById('lobby-qr');
          // Drawn rather than fetched, so the waiting screen works on a phone
          // that has already lost the network it is trying to share over.
          if (qr) qr.innerHTML = renderSVG(link, { border: 2 });

          const copy = document.getElementById('lobby-copy');
          copy?.addEventListener('click', () => {
            void navigator.clipboard?.writeText(link);
            if (copy) copy.textContent = 'Copied';
            window.setTimeout(() => copy && (copy.textContent = 'Copy link'), 1400);
          });
          const share = document.getElementById('lobby-share') as HTMLButtonElement | null;
          // The actual use of this is sending it to somebody, and copy then
          // switch apps is the clunkiest part of every link-based game.
          if (share && typeof navigator.share === 'function') {
            share.hidden = false;
            share.addEventListener('click', () => {
              void navigator.share({ title: 'Dead Ball', url: link }).catch(() => {});
            });
          }
          if (!lobby?.open) lobby?.showModal();
        };

        /**
         * Opened from a link.
         *
         * Shown what they are joining before they are asked to join it: the
         * host's team and which kick. Accepting something you have not been
         * shown is not accepting.
         */
        const invited = roomFrom(new URL(window.location.href));
        if (invited) {
          void wire.peek(invited).then((room) => {
            const blurb = document.getElementById('accept-blurb');
            if (!room) {
              // A dead link is said plainly rather than left to fail on join.
              // The usual cause is the host closing their tab, which in this
              // build is exactly what "the server went away" looks like.
              if (blurb) {
                blurb.textContent =
                  'That game is not there any more. Whoever invited you may have closed it.';
              }
              const join = document.querySelector<HTMLButtonElement>(
                '#accept-form button[type=submit]'
              );
              if (join) join.disabled = true;
            } else {
              const kick =
                DISCIPLINES.find((d) => d.id === room.settings.discipline)?.label ?? 'Penalties';
              if (blurb) {
                blurb.textContent = `${room.host.name || 'Somebody'} has invited you to a ${kick.toLowerCase()} shootout.`;
              }
            }
            if (!accept?.open) accept?.showModal();
          });
        }

        document.getElementById('accept-form')?.addEventListener('submit', (event) => {
          event.preventDefault();
          if (!invited) return;
          const name = (document.getElementById('accept-name') as HTMLInputElement | null)?.value ?? '';
          accept?.close();
          void wire.guest(invited, myTeam(name)).then((transport) => {
            follow(transport);
            showJoined(name);
          });
        });

        document.getElementById('accept-no')?.addEventListener('click', () => {
          accept?.close();
          // Out of the address bar too, or a refresh asks again.
          forgetRoom(window.location, window.history);
        });

        /** The guest's side of the waiting screen: no link to share, just who. */
        const showJoined = (name: string) => {
          setLobbyText('lobby-heading', 'Joining');
          setLobbyText('lobby-team', name || 'Your team');
          setLobbyText('lobby-other', 'connecting…');
          setLobbyText('lobby-link', '');
          const qr = document.getElementById('lobby-qr');
          if (qr) qr.innerHTML = '';
          for (const id of ['lobby-copy', 'lobby-share']) {
            const button = document.getElementById(id) as HTMLButtonElement | null;
            if (button) button.hidden = true;
          }
          if (!lobby?.open) lobby?.showModal();
        };

        document.getElementById('lobby-cancel')?.addEventListener('click', () => {
          // Destroys the room rather than walking away from it, so nothing
          // accumulates that nobody will ever join.
          if (game.connectedAs() !== null) game.disconnect();
          else live?.close();
          live = null;
          lobby?.close();
          forgetRoom(window.location, window.history);
          paintModes();
        });

        const skyChoices = [...document.querySelectorAll<HTMLButtonElement>('#sky-choices button')];
        const logDownload = document.getElementById('log-download') as HTMLButtonElement | null;
        const logClear = document.getElementById('log-clear') as HTMLButtonElement | null;

        // The clear button only wipes on its second press. Armed state lives
        // here rather than on the element so a stray repaint cannot resurrect
        // it, and the timer disarms it for anyone who walked away mid-press.
        let clearArmed = false;
        let disarmTimer = 0;
        const disarmClear = () => {
          clearArmed = false;
          window.clearTimeout(disarmTimer);
        };

        const paintLog = () => {
          const count = game.log.all().length;
          if (logDownload) {
            // The count is the whole point of the label: a button that hands
            // you an empty file is worse than no button at all.
            logDownload.textContent = `Download shot log (${count} ${count === 1 ? 'shot' : 'shots'})`;
            logDownload.disabled = count === 0;
          }
          if (logClear) {
            logClear.hidden = count === 0;
            logClear.textContent = clearArmed ? 'Press again to clear' : 'Clear the log';
            logClear.dataset.armed = String(clearArmed);
          }
        };

        const paintSettings = () => {
          const muted = game.isMuted();
          for (const button of soundChoices) {
            button.setAttribute(
              'aria-pressed',
              String((button.dataset.sound === 'off') === muted)
            );
          }
          for (const button of skyChoices) {
            button.setAttribute('aria-pressed', String(button.dataset.sky === game.currentSkyId()));
          }
          paintLog();
        };

        logDownload?.addEventListener('click', () => {
          game.log.download();
          disarmClear();
          paintLog();
        });

        logClear?.addEventListener('click', () => {
          if (!clearArmed) {
            clearArmed = true;
            window.clearTimeout(disarmTimer);
            disarmTimer = window.setTimeout(() => {
              disarmClear();
              paintLog();
            }, 4000);
            paintLog();
            return;
          }
          disarmClear();
          game.log.clear();
          paintLog();
        });

        for (const button of soundChoices) {
          button.addEventListener('click', () => {
            game.setMuted(button.dataset.sound === 'off');
            paintSettings();
          });
        }
        for (const button of skyChoices) {
          button.addEventListener('click', () => {
            if (button.dataset.sky) game.useSky(button.dataset.sky);
            paintSettings();
          });
        }

        document.getElementById('squad-open')?.addEventListener('click', (event) => {
          paintPlayers();
          showForm(false);
          if (!squad?.open) squad?.showModal();
          // Blurred so the button does not keep a focus ring behind the panel,
          // which reads as two things being open at once.
          (event.currentTarget as HTMLButtonElement).blur();
        });
        document.getElementById('squad-close')?.addEventListener('click', () => squad?.close());

        document.getElementById('settings-open')?.addEventListener('click', (event) => {
          // A dialog opening is a fresh start, so nothing is left armed from
          // the last time it was open.
          disarmClear();
          paintSettings();
          if (!settings?.open) settings?.showModal();
          (event.currentTarget as HTMLButtonElement).blur();
        });
        document
          .getElementById('settings-close')
          ?.addEventListener('click', () => settings?.close());

        paintSettings();
        paintPlayers();
        paintSkills();
      })
      .catch((error) => console.error('[deadball] failed to start', error));
  }
</script>

