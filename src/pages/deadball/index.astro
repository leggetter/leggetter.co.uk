  /* Unmistakable rather than merely tinted: filled, darker text, heavier, and
     carrying a dot no unselected button has. Colour alone is not a signal
     everybody can read. */
  #modes button:not(#mute)[aria-pressed='true'],
  #views button[aria-pressed='true'] {
    background: #7dd3fc;
    border-color: #7dd3fc;
    color: #05202e;
    font-weight: 700;
    box-shadow: 0 0 0 3px rgba(125, 211, 252, 0.25);
