---
interface Props {
  url: string;
  title: string;
  date: Date;
  excerpt: string;
  thumb?: string | undefined;
  draft?: boolean;
}

const { url, title, date, excerpt, thumb, draft = false } = Astro.props;

const formatted = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<li>
  <article class="post-card">
    <h2><a href={url}>{title}</a></h2>
    <p class="post-card__meta">
      <time datetime={date.toISOString().slice(0, 10)}>{formatted}</time>
      {draft && <span class="post-card__draft">Draft</span>}
    </p>
    {
      thumb && (
        <a href={url} title={title}>
          <img class="post-card__thumb" src={thumb} alt={`${title} preview image`} loading="lazy" />
        </a>
      )
    }
    {excerpt && <p class="post-card__excerpt">{excerpt}</p>}
    <p class="post-card__more">
      <a href={url}>Read more…</a>
    </p>
  </article>
</li>
