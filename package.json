  },
  "homepage": "https://github.com/leggetter/leggetter.co.uk",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "markdown-it": "^15.0.2",
    "three": "^0.186.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
